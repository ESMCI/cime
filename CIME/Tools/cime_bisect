#!/usr/bin/env bash

# A thin wrapper around "git bisect start --first-parent" that drives the
# whole bisection: start, run, report, reset.
#
# Bisecting only along the first-parent chain ensures that only mainline
# (merge) commits are tested, since there are no enforced standards for
# commits on development branches. The bad commit is always the current
# HEAD. Run this from the root of the repo you want to bisect (CIME or the
# model that houses it).
#
# If you are bisecting with a create_test command, you need to be careful
# with the create_test flags. If you are doing full runs on a batch system,
# you should provide --wait. If you are bisecting a DIFF, you should provide
# --ignore-namelists so that NML issues won't muddy the bisection.

usage() {
    cat <<USAGE
Usage: $(basename "$0") <good> <cmd> [<args>...]
       $(basename "$0") --help

Bisect between <good> and HEAD (bad), following first parents only, running
<cmd> at each step via "git bisect run". Submodules are updated before each
run. The repo is reset to its original state when done.

Examples:
  # Bisect ERS.f45_g37.B1850C5 which got broken in the last 4 commits
  cd <root-of-broken-repo>
  $(basename "$0") HEAD~4 ./cime/scripts/create_test ERS.f45_g37.B1850C5 --wait

  # Bisect a build error
  $(basename "$0") HEAD~4 ./cime/scripts/create_test ERS.f45_g37.B1850C5 --no-run

  # Bisect a DIFF
  $(basename "$0") HEAD~4 ./cime/scripts/create_test ERS.f45_g37.B1850C5 -c -b master --wait --ignore-namelists
USAGE
}

# Arg parsing
case "$1" in
    -h|--help) usage; exit 0 ;;
esac

if [ "$#" -lt 2 ]; then
    usage >&2
    exit 1
fi

good="$1"
shift

# Sanity checks
if [ ! -e .git ]; then
    echo "Please run from the root of a git repo (CIME or the model that houses it)" >&2
    exit 1
fi

if ! git rev-parse --verify --quiet "$good^{commit}" >/dev/null; then
    echo "'$good' is not a valid commit" >&2
    exit 1
fi

if ! git merge-base --is-ancestor "$good" HEAD; then
    echo "Good commit '$good' is not an ancestor of HEAD" >&2
    exit 1
fi

# We always want to reset after bisection is done
cleanup() {
    git bisect reset >/dev/null 2>&1
    git submodule update --recursive
}
trap cleanup EXIT

# Start and run the bisection
git bisect start --first-parent HEAD "$good" || exit 1

git bisect run bash -c 'git submodule update --recursive && "$@"' bisect-run "$@"
rc=$?

# Report
if [ "$rc" -eq 0 ]; then
    echo "####################################################"
    echo "FIRST BAD COMMIT IS:"
    echo "####################################################"
    git --no-pager show --no-patch "$(git rev-parse refs/bisect/bad)"
fi

exit "$rc"
